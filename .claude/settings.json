{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Write(./.env)",
      "Write(./**/.env)",
      "Bash(cat .env)",
      "Bash(less .env)",
      "Bash(head .env)",
      "Bash(tail .env)",
      "Bash(grep * .env)",
      "Bash(source .env)"
    ]
  }
}
